Options -Indexes

<FilesMatch "^(\.env(\..*)?|composer\.(json|lock)|database\.sql|\.gitignore|AGENTS\.md|CLAUDE\.md|GEMINI\.md)$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(?:app|config|storage|database)(?:/|$) - [F,L,NC]
    RewriteRule ^(?:\.git|\.agents|\.claude|\.gemini|\.opencode)(?:/|$) - [F,L,NC]
</IfModule>

